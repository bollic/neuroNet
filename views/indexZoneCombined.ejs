 <!-- views/indexZoneCombined.ejs -->
<%- include('layout/headerZoneGeo') %>
<script>
  window.APP_VIEW = "<%= mode %>";
  window.APP_MODE = "<%= mode %>";
  window.GROUP_TYPE = "<%= group.groupType %>";
</script>
<style>
  html, body { height: 100%; }
  #map { height: 80vh; width: 100%; }
  .leaflet-container { z-index: 0 !important; }
</style>

<div class="flex flex-row h-[80vh]">
  <div class="drawer drawer-start drawer-mobile md:drawer-open">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />

    <!-- Contenuto principale (mappa) -->
    <div class="drawer-content relative">
      <div id="map" class="w-full h-[80vh] rounded-lg shadow-md"></div>
      
      <!-- Pulsante Add Parcelle (solo esempio) -->
      <a href="/addParcelle" class="absolute top-4 right-4 z-50">
        <button class="btn btn-warning btn-sm shadow-lg">
          <i class="fas fa-plus"></i> Ajouter une parcelle
        </button>
      </a>
      <div class="fixed top-36 left-4 z-[3000]">
        <button
          id="search-btn"
          class="bg-white rounded-full w-12 h-12 shadow-lg">
          🔍
        </button>
      </div>

                
          <div id="search-panel"
              class="hidden fixed
                      top-28 left-4
                      z-[3500]
                      w-56
                      max-h-[70vh]
                      overflow-y-auto
                      bg-white                    
                      rounded-xl
                      shadow-xl
                      p-3">
                      <button id="close-search"
                        class="absolute top-2 right-3 text-xl font-bold">
                        ✕</button>

                  
  <%- include('partials/listCombined') %>
                          

          </div>

      <%- include('partials/layerControls') %>
    </div>

    <!-- Sidebar -->
    <div class="drawer-side">
      <label for="my-drawer" class="drawer-overlay"></label>
      <aside class="hidden md:block w-80 bg-base-200 p-4 overflow-y-auto">   
    
  <%- include('partials/listCombined') %>
      </aside>
    </div>
  </div>
</div>
<script>
  
// Apertura / chiusura pannello con la lente
document.getElementById("search-btn")
  ?.addEventListener("click", () => {
    document
      .getElementById("search-panel")
      ?.classList.toggle("hidden");

        document
      .getElementById("search-label")
      ?.classList.toggle("hidden");
  });

// Chiusura con la X
document.getElementById("close-search")
  ?.addEventListener("click", () => {

    document
      .getElementById("search-panel")
      ?.classList.add("hidden");

    document
      .getElementById("search-label")
      ?.classList.add("hidden");

  });
</script>
<script>
  window.parcelles = <%- JSON.stringify(parcelles || []) %>;
  window.points = <%- JSON.stringify(points || []) %>;

   console.log("Zones:", window.parcelles);
  console.log("Points:", window.points);
  //console.log("Zones:", parcelles);
  //console.log("Points (limit 3):", points.slice(0,3));
</script>
<script type="module" src="/js/dataAuthorParcelle.js" defer></script>
<%- include('layout/footer') %>