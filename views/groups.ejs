<!-- groups.ejs -->
<%- include('layout/header') %>

<div class="max-w-6xl mx-auto p-8 space-y-6">
  <h2 class="text-3xl font-bold text-purple-700 text-center mb-8">
    🌍 Découvrez Terria

    Choisissez un univers puis rejoignez un groupe.
  </h2>

 <% if (Object.keys(groupsByType).length > 0) { %>

  <% Object.keys(groupsByType).forEach(type => { %>

    <% if (type === "mobile-service") { %>

      <div class="mb-5">
        <h3 class="text-2xl font-bold text-purple-700">
          🚛 Services mobiles
        </h3>
        <p class="text-gray-600">
          Un véhicule se déplace sur le terrain et les citoyens peuvent suivre son intervention.
          
        </p>
      </div>

    <% } else if (type === "community") { %>

      <div class="mb-5">
        <h3 class="text-2xl font-bold text-purple-700">
          👥 Communautés
        </h3>
        <p class="text-gray-600">
          Créez ou rejoignez une communauté locale
          pour partager des signalements ou des idées.</p>
      </div>
  
      <% } else if (type === "observation") { %>

       <div class="mb-5">
        <h3 class="text-2xl font-bold text-purple-700">
          👁 Univers : Observations
        </h3>
        <p class="text-gray-600">
          Créez ou rejoignez une communauté locale
          pour partager des signalements ou des idées.</p>
      </div>

      <% } else if (type === "maintenance") { %>

       <div class="mb-5">
        <h3 class="text-2xl font-bold text-purple-700">
          🔧 Univers : Maintenance
        </h3>
        <p class="text-gray-600">
          Créez ou rejoignez une communauté locale
          pour partager des signalements ou des idées.</p>
      </div>

    <% } %>

    <div class="grid md:grid-cols-3 gap-6">
    <% groupsByType[type].forEach(group => { %>
      <div class="border rounded-xl p-4 bg-gradient-to-br from-purple-50 via-pink-50 to-blue-50 hover:shadow-xl transition">

      <!-- ID + Numero Membri -->
      <div class="flex justify-between items-center mb-2">
        <span class="font-semibold text-lg text-purple-700 flex items-center gap-2">
          <i class="fas fa-users"></i> <%= group.name || "Nom de groupe" %>
        </span>
        <span class="text-xs px-2 py-1 rounded-full bg-purple-100 text-purple-700 font-medium">
            <%= group.totalMembers %> membres
        </span>
      </div>

 
  <!-- 📝 Descrizione sintetica -->
  <p class="text-sm text-gray-700 italic mb-2">
    <%= group.description 
        ? (group.description.length > 80 
            ? group.description.substring(0, 80) + "..." 
            : group.description)
        : "Aucune description disponible." 
    %>
  </p>

  <!-- 🏷️ Keywords -->
  <% if (group.keywords && group.keywords.length > 0) { %>
    <div class="flex flex-wrap gap-1 mb-3">
      <% group.keywords.forEach(kw => { %>
        <span class="text-xs bg-purple-200 text-purple-800 px-2 py-1 rounded-full">
          #<%= kw %>
        </span>
      <% }) %>
    </div>
  <% } %>

  <!-- 📌 Points e ultimo punto -->
<p class="text-sm text-gray-600 mb-1">
  📍 <%= group.pointsCount %> points
</p>

  <p class="text-xs text-gray-500 mb-3">
    🕓 Dernier point :
    <%= group.lastPoint ? group.lastPoint.name : '–' %>
    <% if (group.lastPoint && group.lastPoint.createdAt) { %>
      (<%= new Date(group.lastPoint.createdAt).toLocaleDateString('fr-FR') %>)
    <% } %>
  </p>

  <!-- Pulsanti -->
  <div class="flex gap-2">
      <% if (user && user.role === 'office') { %>
    <a href="/groups/<%= group.groupId %>" class="btn btn-xs btn-outline btn-primary flex-1">👀 Voir</a>
        <% } %>

    <a href="/signup?role=field&group=<%= group.groupId %>" class="btn btn-xs btn-primary flex-1">🚀 Rejoindre</a>
    <a
      href="/openZoneGeo/<%= group.groupId %>"
      target="_blank"
      class="btn btn-xs btn-outline btn-primary px-3"
      title="Aperçu public"
    >
   🗺️ Voir la carte
    </a>
  </div>

</div>

      <% }) %>
    </div>

   <% }) %>
  <% } else { %>
    <p class="text-gray-500 text-center">Aucun groupe actif pour le moment.</p>
  <% } %>
</div>

<%- include('layout/footerIndex') %>
