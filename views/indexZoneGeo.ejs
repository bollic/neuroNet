</div> <!-- 🔒 chiusura flex-row -->
<!-- ✅ MODAL EDIT (DaisyUI) -->
<input type="checkbox" id="edit-modal" class="modal-toggle" />
    <% if (mode === "field") { %> 
        <div class="modal">
          <div class="modal-box max-h-[85vh] overflow-y-auto">

            <h3 class="font-bold text-lg mb-4">
              Modifier
            </h3>

            <!-- Nom -->
            <div class="form-control mb-3">
              <label class="label">
                <span class="label-text">Nom</span>
              </label>

              <input
                id="edit-name"
                type="text"
                class="input input-bordered input-sm w-full"
              />
            </div>


            <!-- Catégorie -->
            <div class="form-control mb-3">
              <label class="label">
                <span class="label-text">Catégorie</span>
              </label>

              <select
                id="edit-category"
                class="select select-bordered select-sm w-full">

                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat.name %>">
                    <%= cat.icon %> - <%= cat.name %>
                  </option>
                <% }); %>

              </select>
            </div>


            <!-- Description -->
            <div class="form-control mb-4">
              <label class="label">
                <span class="label-text">Description</span>
              </label>

              <textarea
                id="edit-description"
                class="textarea textarea-bordered w-full"></textarea>
            </div>


            <!-- Champs dynamiques Observation -->
            <% if (
              group.groupType === "observation" &&
              observationForm &&
              observationForm.fields &&
              observationForm.fields.length
            ) { %>

              <div class="divider">
                Observations
              </div>

              <div id="edit-observation-fields">

                <% observationForm.fields.forEach(function(field) { %>

                  <div class="form-control mb-3">

                    <label class="label">
                      <span class="label-text">
                        <%= field.label %>

                        <% if (field.required) { %>
                          <span class="text-error">*</span>
                        <% } %>
                      </span>
                    </label>


                    <% if (field.type === "text") { %>

                      <input
                        type="text"
                        class="input input-bordered input-sm w-full edit-observation-field"
                        data-field-name="<%= field.name %>"
                      />


                    <% } else if (field.type === "number") { %>

                      <input
                        type="number"
                        class="input input-bordered input-sm w-full edit-observation-field"
                        data-field-name="<%= field.name %>"
                      />


                    <% } else if (field.type === "boolean") { %>

                      <input
                        type="checkbox"
                        class="checkbox edit-observation-field"
                        data-field-name="<%= field.name %>"
                      />


                    <% } else if (field.type === "select") { %>

                      <select
                        class="select select-bordered select-sm w-full edit-observation-field"
                        data-field-name="<%= field.name %>">

                        <option value="">
                          Sélectionner...
                        </option>

                        <% (field.options || []).forEach(function(option) { %>

                          <option value="<%= option %>">
                            <%= option %>
                          </option>

                        <% }); %>

                      </select>

                    <% } %>

                  </div>

                <% }); %>

              </div>

            <% } %>


            <!-- Boutons -->

            <div class="modal-action">

              <button
                onclick="saveEdit()"
                class="btn btn-primary">
                Modifier
              </button>

              <label
                for="edit-modal"
                class="btn">
                Annuler
              </label>

            </div>

          </div>
        </div>
    <% } %>
