<!--indexZoneParcelle.ejs-->
<%- include('layout/headerZoneGeo') %>
<script>
  window.APP_VIEW = "<%= mode %>";
  window.APP_MODE = "<%= mode %>";
  window.GROUP_TYPE = "<%= group.groupType %>";
</script>
<style>
  html, body { height: 100%; }
  #map { height: 80vh; width: 100%; }
  .leaflet-container { z-index: 0 !important; }
</style>

  <style>
.highlight-row {
  background-color: #ffe9a8 !important;
}
</style>

<style>
  #group-feed {
    max-height: none !important;   /* niente limite altezza */
    overflow-y: visible !important; /* elimina scrollbar verticale */
  }
</style>

<div class="flex flex-row h-[80vh]">
  <div class="drawer drawer-start drawer-mobile md:drawer-open">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />

    <!-- CONTENUTO PRINCIPALE -->
    <div class="drawer-content relative">
       <div id="map" class="w-full h-[80vh] rounded-lg shadow-md"></div>

      <!-- MENU MOBILE FLOTTANTE -->
      <div class="fixed top-36 left-4 z-[3000]">
        <button
          id="open-parcelle"
          class="bg-white rounded-full w-12 h-12 shadow-lg">
          ☰
        </button>
      </div>


      <!-- LISTA PARCELLE MOBILE -->
      <div id="parcelle-panel"
           class="hidden fixed
                  top-28 left-4
                  z-[3500]
                  w-56
                  max-h-[70vh]
                  overflow-y-auto
                  bg-white
                  rounded-xl
                  shadow-xl
                  p-3">

        <button
          id="close-parcelle"
          class="absolute top-2 right-3 text-xl font-bold">
          ✕
        </button>

        <%- include('partials/listParcelle') %>

      </div>


      <%- include('partials/layerControls') %>

    </div>


    <!-- SIDEBAR DESKTOP -->
    <div class="drawer-side">

      <label
        for="my-drawer"
        class="drawer-overlay">
      </label>

      <aside class="hidden md:block w-80 bg-base-200 p-4 overflow-y-auto">

        <%- include('partials/listParcelle') %>

      </aside>

    </div>

  </div>

</div>


<!-- APERTURA / CHIUSURA LISTA MOBILE -->
<script>

  document.getElementById("open-parcelle")
    ?.addEventListener("click", () => {

      document
        .getElementById("parcelle-panel")
        ?.classList.toggle("hidden");

    });


  document.getElementById("close-parcelle")
    ?.addEventListener("click", () => {

      document
        .getElementById("parcelle-panel")
        ?.classList.add("hidden");

    });

</script>
     <!-- 🔥 BOTTONE ADD SEMPRE VISIBILE -->

<!-- 🔥 GLOBAL FLOATING BUTTON (FORZA SOPRA TUTTO) -->
<div style="
  position: fixed;
  bottom: 64px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2147483647;
  pointer-events: auto;
">
  <a href="/addParcelle">
    <button style="
      background: #facc15;
      color: black;
      padding: 12px 20px;
      border-radius: 9999px;
      font-weight: 600;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      border: none;
    ">

      <span>➕</span>
      <span>Ajouter</span>

    </button>
  </a>

</div>

<script>

  // Variabile JS usata dal client
window.parcelles = <%- JSON.stringify(parcelles || []) %>;
  console.log("📦 Parcelles dal server:", <%- JSON.stringify(parcelles) %>);
  window.CATEGORIES = <%- JSON.stringify(categories || []) %>;     
   console.log("🧪 CATEGORIES DAL SERVER:", window.CATEGORIES);
</script>

<script type="module" src="/js/dataAuthorParcelle.js" defer></script>
<%- include('layout/footer') %>
