
<!-- views/group-detail.ejs-->
<!-- views/group-detail.ejs-->
<%- include('layout/header') %>

<div class="max-w-6xl mx-auto px-4 py-8">

  <!-- ========================================================= -->
  <!-- EN-TÊTE -->
  <!-- ========================================================= -->

  <div class="text-center mb-10">

    <h1 class="text-3xl md:text-4xl font-extrabold text-primary">
      📋 Configuration du groupe
    </h1>

    <p class="mt-3 text-lg font-semibold text-gray-700">
      <%= group.name || "Nom du groupe" %>
    </p>

    <% if (group.groupType) { %>
      <div class="mt-2">
        <span class="badge badge-primary badge-outline">
          <% if (group.groupType === 'observation') { %>
            🔍 Observation
          <% } else if (group.groupType === 'maintenance') { %>
            🏘️ Maintenance
          <% } else if (group.groupType === 'mobile-service') { %>
            🚚 Service mobile
          <% } else if (group.groupType === 'community') { %>
            👥 Communauté
          <% } else { %>
            <%= group.groupType %>
          <% } %>
        </span>
      </div>
    <% } %>

  </div>


  <!-- ========================================================= -->
  <!-- CONFIGURATION / ADMIN -->
  <!-- ========================================================= -->

  <% if (user && (user.role === 'admin' || isGroupOffice)) { %>

    <section class="bg-base-100 rounded-2xl shadow-md border border-base-300 overflow-hidden mb-8">

      <!-- Section header -->
      <div class="bg-base-200 px-6 py-5 border-b border-base-300">

        <h2 class="text-2xl font-bold text-primary">
          ⚙️ Informations du groupe
        </h2>

        <p class="text-sm text-gray-600 mt-1">
          Modifiez les informations générales et l'utilisation principale du groupe.
        </p>

      </div>


      <!-- Formulaire -->
      <div class="p-6 md:p-8">

        <form
          action="/groups/<%= groupId %>/updateInfo"
          method="POST"
          class="max-w-3xl mx-auto space-y-6"
        >

          <!-- Nom -->
          <div>

            <label
              for="groupName"
              class="block text-sm font-semibold text-gray-700 mb-1"
            >
              Nom du groupe
            </label>

            <input
              id="groupName"
              type="text"
              name="name"
              value="<%= group.name %>"
              placeholder="Ex : Signalements voirie • Inspections sécurité • Suivi terrain"
              class="input input-bordered w-full"
            />

          </div>


          <!-- Type -->
          <div>

            <label
              for="groupType"
              class="block text-sm font-semibold text-gray-700 mb-1"
            >
              Utilisation principale
            </label>

            <select
              id="groupType"
              name="groupType"
              class="select select-bordered w-full"
            >

              <option
                value="maintenance"
                <%= group.groupType === "maintenance" ? "selected" : "" %>
              >
                🏘️ Maintenance
              </option>

              <option
                value="mobile-service"
                <%= group.groupType === "mobile-service" ? "selected" : "" %>
              >
                🚚 Service mobile
              </option>

              <option
                value="observation"
                <%= group.groupType === "observation" ? "selected" : "" %>
              >
                🔍 Observation
              </option>

              <option
                value="community"
                <%= group.groupType === "community" ? "selected" : "" %>
              >
                👥 Communauté
              </option>

            </select>

          </div>


          <!-- Description -->
          <div>

            <label
              for="groupDescription"
              class="block text-sm font-semibold text-gray-700 mb-1"
            >
              Description
            </label>

            <textarea
              id="groupDescription"
              name="description"
              rows="4"
              placeholder="Décrivez le type de signalements, qui peut les créer et comment ils sont utilisés."
              class="textarea textarea-bordered w-full"
            ><%= group.description %></textarea>

          </div>


          <!-- Mots-clés -->
          <div>

            <label
              for="groupKeywords"
              class="block text-sm font-semibold text-gray-700 mb-1"
            >
              Mots-clés
            </label>

            <input
              id="groupKeywords"
              type="text"
              name="keywords"
              value="<%= group.keywords?.join(', ') %>"
              placeholder="Ex : sécurité, terrain, inspection, incident"
              class="input input-bordered w-full"
            />

            <p class="text-xs text-gray-500 mt-1">
              Séparez les mots-clés par des virgules.
            </p>

          </div>


          <!-- Sauvegarder -->
          <div class="pt-2 flex justify-end">

            <button
              type="submit"
              class="btn btn-primary px-6"
            >
              💾 Sauvegarder
            </button>

          </div>

        </form>

      </div>

    </section>

  <% } %>


  <!-- ========================================================= -->
  <!-- FORMULAIRE D'OBSERVATION -->
  <!-- ========================================================= -->

  <% if (
    user &&
    (user.role === 'admin' || isGroupOffice) &&
    group.groupType === 'observation'
  ) { %>

    <section class="bg-base-100 rounded-2xl shadow-md border border-base-300 overflow-hidden mb-8">

      <!-- Header -->
      <div class="bg-base-200 px-6 py-5 border-b border-base-300">

        <div class="flex items-center gap-3">

          <div class="text-3xl">
            🔍
          </div>

          <div>

            <h2 class="text-2xl font-bold text-primary">
              Formulaire d'observation
            </h2>

            <p class="text-sm text-gray-600 mt-1">
              Définissez les informations qui devront être renseignées
              lors d'une observation.
            </p>

          </div>

        </div>

      </div>


      <!-- Contenu -->
      <div class="p-6 md:p-8">

        <!-- =================================================== -->
        <!-- AJOUTER UN CHAMP -->
        <!-- =================================================== -->

        <div class="max-w-3xl mx-auto">

          <div class="mb-5">

            <h3 class="text-lg font-bold text-gray-800">
              Ajouter un champ
            </h3>

            <p class="text-sm text-gray-500 mt-1">
              Choisissez les informations que les utilisateurs devront
              pouvoir renseigner lors d'une observation.
            </p>

          </div>


          <form
            action="/groups/<%= groupId %>/observation-form"
            method="POST"
            class="bg-base-200 rounded-xl p-5 md:p-6 space-y-5"
          >

            <!-- Nom du champ -->
            <div>

              <label
                for="observationFieldLabel"
                class="block text-sm font-semibold text-gray-700 mb-1"
              >
                Nom du champ
              </label>

              <input
                type="text"
                id="observationFieldLabel"
                name="label"
                placeholder="Ex : État général"
                class="input input-bordered w-full bg-base-100"
                required
              />

            </div>


            <!-- Type du champ -->
            <div>

              <label
                for="observationFieldType"
                class="block text-sm font-semibold text-gray-700 mb-1"
              >
                Type de champ
              </label>

              <select
                id="observationFieldType"
                name="type"
                class="select select-bordered w-full bg-base-100"
              >

                <option value="text">
                  Texte
                </option>

                <option value="number">
                  Nombre
                </option>

                <option value="boolean">
                  Oui / Non
                </option>

                <option value="select">
                  Liste de choix
                </option>

              </select>

            </div>


            <!-- Obligatoire -->
            <label class="flex items-center gap-3 cursor-pointer">

              <input
                type="checkbox"
                name="required"
                class="checkbox checkbox-primary"
              />

              <span class="text-sm font-medium text-gray-700">
                Champ obligatoire
              </span>

            </label>


            <!-- Ajouter -->
            <div class="flex justify-end pt-2">

              <button
                type="submit"
                class="btn btn-primary px-6"
              >
                ➕ Ajouter le champ
              </button>

            </div>

          </form>


          <!-- ================================================= -->
          <!-- CHAMPS CONFIGURÉS -->
          <!-- ================================================= -->

          <div class="mt-8">

            <div class="flex items-center justify-between mb-4">

              <h3 class="text-lg font-bold text-gray-800">
                Champs configurés
              </h3>

              <% if (observationForm && observationForm.fields) { %>

                <span class="badge badge-outline">
                  <%= observationForm.fields.length %>
                  <% if (observationForm.fields.length === 1) { %>
                    champ
                  <% } else { %>
                    champs
                  <% } %>
                </span>

              <% } %>

            </div>


            <% if (observationForm && observationForm.fields.length > 0) { %>

              <div class="space-y-3">

                <% observationForm.fields.forEach(field => { %>

                  <div class="bg-base-100 border border-base-300 rounded-xl p-4">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                      <!-- Infos champ -->
                      <div>

                        <div class="font-semibold text-gray-800">
                          <%= field.label %>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 mt-1">

                          <span class="badge badge-ghost badge-sm">

                            <% if (field.type === 'text') { %>
                              Texte

                            <% } else if (field.type === 'number') { %>
                              Nombre

                            <% } else if (field.type === 'boolean') { %>
                              Oui / Non

                            <% } else if (field.type === 'select') { %>
                              Liste de choix

                            <% } else { %>
                              <%= field.type %>

                            <% } %>

                          </span>


                          <% if (field.required) { %>

                            <span class="badge badge-error badge-outline badge-sm">
                              Obligatoire
                            </span>

                          <% } else { %>

                            <span class="text-xs text-gray-400">
                              Facultatif
                            </span>

                          <% } %>

                        </div>

                      </div>

                    </div>

                  </div>

                <% }) %>

              </div>

            <% } else { %>

              <div class="border border-dashed border-gray-300 rounded-xl p-6 text-center">

                <div class="text-3xl mb-2">
                  📝
                </div>

                <p class="font-medium text-gray-600">
                  Aucun champ configuré
                </p>

                <p class="text-sm text-gray-400 mt-1">
                  Ajoutez le premier champ du formulaire ci-dessus.
                </p>

              </div>

            <% } %>

          </div>

        </div>

      </div>

    </section>

  <% } %>


  <!-- ========================================================= -->
  <!-- ACCÈS AU GROUPE -->
  <!-- ========================================================= -->

  <section class="bg-base-100 rounded-2xl shadow-md border border-base-300 p-6 mb-10">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

      <div>

        <h2 class="text-lg font-bold text-gray-800">
          🔐 Accès au groupe
        </h2>

        <p class="text-sm text-gray-500 mt-1">
          Contrôlez si le groupe est accessible publiquement.
        </p>

      </div>


      <form
        action="/groups/<%= groupId %>/toggle-visibility"
        method="POST"
      >

        <button
          type="submit"
          class="btn btn-outline btn-warning"
        >

          <% if (group.isPublic) { %>
            🔒 Limiter l’accès au groupe
          <% } else { %>
            🔓 Ouvrir le groupe au public
          <% } %>

        </button>

      </form>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- APERÇU DU GROUPE -->
  <!-- ========================================================= -->

  <section class="mb-10">

    <div class="text-center mb-6">

      <h2 class="text-2xl font-bold text-primary">
        <%= group.name || "Nom non disponible" %>
      </h2>

      <p class="mt-2 text-gray-600">
        <%= group.description || "Aucune description disponible." %>
      </p>

      <% if (group.keywords && group.keywords.length > 0) { %>

        <div class="mt-3 flex flex-wrap justify-center gap-2">

          <% group.keywords.forEach(keyword => { %>

            <span class="badge badge-outline">
              <%= keyword %>
            </span>

          <% }) %>

        </div>

      <% } %>

    </div>


    <!-- ======================================================= -->
    <!-- CONTENU GROUPE -->
    <!-- ======================================================= -->

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">


      <!-- ===================================================== -->
      <!-- COLONNE GAUCHE -->
      <!-- ===================================================== -->

      <aside class="md:col-span-1 bg-base-100 rounded-2xl shadow-md border border-base-300 p-5 space-y-8">


        <!-- Membres -->
        <section>

          <h3 class="text-lg font-bold text-primary mb-3">
            👥 Membres
          </h3>

          <% if (members && members.length > 0) { %>

            <ul class="space-y-2 text-gray-700">

              <% members.forEach(m => { %>

                <li class="flex items-start gap-2">

                  <span class="w-2 h-2 bg-primary rounded-full mt-2 flex-shrink-0"></span>

                  <div>

                    <div class="text-sm">
                      <%= m.email %>
                    </div>

                    <div class="text-xs text-gray-500">
                      <%= m.role %>
                    </div>

                  </div>

                </li>

              <% }) %>

            </ul>

          <% } else { %>

            <p class="text-gray-400 text-sm">
              Aucun membre trouvé.
            </p>

          <% } %>

        </section>


        <!-- Points -->
        <section>

          <h3 class="text-lg font-bold text-primary mb-3">
            📍 Points du groupe
          </h3>

          <% if (points && points.length > 0) { %>

            <div class="overflow-x-auto border border-base-300 rounded-lg">

              <table class="w-full text-sm">

                <thead class="bg-base-200">

                  <tr class="text-left">

                    <th class="p-2">
                      Nom
                    </th>

                    <th class="p-2">
                      Catégorie
                    </th>

                  </tr>

                </thead>

                <tbody>

                  <% points.forEach(p => { %>

                    <tr class="border-t border-base-300 hover:bg-base-200">

                      <td class="p-2">
                        <%= p.name || '–' %>
                      </td>

                      <td class="p-2">
                        <%= p.category || 'Sans catégorie' %>
                      </td>

                    </tr>

                  <% }) %>

                </tbody>

              </table>

            </div>

          <% } else { %>

            <p class="text-gray-400 text-sm">
              Aucun point trouvé.
            </p>

          <% } %>

        </section>

      </aside>


      <!-- ===================================================== -->
      <!-- FEED -->
      <!-- ===================================================== -->

      <div class="md:col-span-2">

        <div class="bg-base-100 rounded-2xl shadow-md border border-base-300 p-5">

          <h3 class="text-lg font-bold text-primary mb-3">
            📌 Feed du groupe
          </h3>

          <!-- groupId transmis au JS -->
          <div
            id="group-feed"
            data-group-id="<%= groupId %>"
            class="mt-4 space-y-4"
          >

            <%- include("partials/groupFeedPublic", { points }) %>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- RETOUR -->
  <!-- ========================================================= -->

  <div class="text-center pb-16">

    <a
      href="/groups"
      class="btn btn-outline btn-primary shadow-md hover:shadow-lg transition"
    >
      ← Retour aux groupes
    </a>

  </div>

</div>


<p class="text-xs opacity-50 text-center mt-6"></p>

<%- include('layout/footer') %>