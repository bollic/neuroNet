   
   <!-- views/partials/groupObservationConfig.ejs -->

    <section class="bg-base-100 rounded-2xl shadow-md border border-base-300 overflow-hidden mb-8">

        <!-- Header -->
        <div class="bg-base-200 px-6 py-4 border-b border-base-300">
          <h2 class="text-xl font-bold text-primary">
            🔍 Formulaire d'observation
          </h2>

          <p class="text-sm text-gray-600 mt-1">
            Informations à renseigner lors d'une observation.
          </p>
        </div>


      <!-- Contenu -->
      <div class="p-6 md:p-8">

        <!-- =================================================== -->
        <!-- AJOUTER UN CHAMP -->
        <!-- =================================================== -->

        <div class="max-w-3xl mx-auto">

            <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold text-gray-800">
              Ajouter un champ
            </h3>

        </div>

            <form
                action="/groups/<%= groupId %>/observation-form"
                method="POST"
                class="bg-base-200 rounded-xl p-4"
              >

                <div class="flex flex-col md:flex-row md:items-end gap-3">

                  <!-- Nom -->
                  <div class="flex-1">
                    <label
                      for="observationFieldLabel"
                      class="block text-sm font-semibold text-gray-700 mb-1"
                    >
                      Nom du champ
                    </label>

                    <input
                      type="text"
                      id="observationFieldLabel"
                      name="label"
                      placeholder="Ex : État général"
                      class="input input-bordered input-sm w-full bg-base-100"
                      required
                    />
                  </div>

                  <!-- Type -->
                  <div class="md:w-44">
                    <label
                      for="observationFieldType"
                      class="block text-sm font-semibold text-gray-700 mb-1"
                    >
                      Type
                    </label>

                    <select
                      id="observationFieldType"
                      name="type"
                      class="select select-bordered select-sm w-full bg-base-100"
                    >
                      <option value="text">Texte</option>
                      <option value="number">Nombre</option>
                      <option value="boolean">Oui / Non</option>
                      <option value="select">Liste de choix</option>
                    </select>
                  </div>

                  <!-- Obligatoire -->
                  <label class="flex items-center gap-2 h-9 px-2 cursor-pointer">
                    <input
                      type="checkbox"
                      name="required"
                      class="checkbox checkbox-primary checkbox-sm"
                    />

                    <span class="text-sm font-medium text-gray-700">
                      Obligatoire
                    </span>
                  </label>

                  <!-- Ajouter -->
                  <button
                    type="submit"
                    class="btn btn-primary btn-sm"
                  >
                    ➕ Ajouter
                  </button>

                </div>

            </form>


          <!-- ================================================= -->
          <!-- CHAMPS CONFIGURÉS -->
          <!-- ================================================= -->

          <div class="mt-2">

            <div class="flex items-center justify-between mb-2">

              <h3 class="text-lg font-bold text-gray-800">
                Champs configurés
              </h3>

              <% if (observationForm && observationForm.fields) { %>

                <span class="badge badge-outline">
                  <%= observationForm.fields.length %>
                  <% if (observationForm.fields.length === 1) { %>
                    champ
                  <% } else { %>
                    champs
                  <% } %>
                </span>

              <% } %>

            </div>


            <% if (observationForm && observationForm.fields.length > 0) { %>

              <div class="space-y-2">

                <% observationForm.fields.forEach(field => { %>

                  <div class="bg-base-100 border border-base-300 rounded-xl px-4 py-2.5">

                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">

                      <!-- Infos champ -->
                      <div>

                        <div class="font-semibold text-gray-800">
                          <%= field.label %>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 mt-0.5">

                          <span class="badge badge-ghost badge-sm">

                            <% if (field.type === 'text') { %>
                              Texte

                            <% } else if (field.type === 'number') { %>
                              Nombre

                            <% } else if (field.type === 'boolean') { %>
                              Oui / Non

                            <% } else if (field.type === 'select') { %>
                              Liste de choix

                            <% } else { %>
                              <%= field.type %>

                            <% } %>

                          </span>


                          <% if (field.required) { %>

                            <span class="badge badge-error badge-outline badge-sm">
                              Obligatoire
                            </span>

                          <% } else { %>

                            <span class="text-xs text-gray-400">
                              Facultatif
                            </span>

                          <% } %>

                        </div>

                      </div>

                    </div>

                  </div>

                <% }) %>

              </div>

            <% } else { %>

              <div class="border border-dashed border-gray-300 rounded-xl p-4 text-center">

                <div class="text-2xl mb-1">
                  📝
                </div>

                <p class="font-medium text-gray-600">
                  Aucun champ configuré
                </p>

                <p class="text-sm text-gray-400 mt-1">
                  Ajoutez le premier champ du formulaire ci-dessus.
                </p>

              </div>

            <% } %>

          </div>

        </div>

      </div>

    </section>


