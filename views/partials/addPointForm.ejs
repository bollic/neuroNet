
  
   <!-- views/partials/addPointForm.ejs -->
  <form id="add-point" method="POST" enctype="multipart/form-data">
  <input type="hidden" id="point" name="point" />
  <input type="hidden" id="pointId" name="pointId" />

      <!-- 👇 QUI -->
  <p class="text-xs opacity-60 mb-2">
    📍 Cliquez sur la carte pour placer le point
  </p>
  <div class="mb-2">
    <input 
      type="text"
      id="form-name"
      name="name"
      class="input input-bordered input-sm w-full"
      placeholder="Nom"
      required
    />
  </div>

  <div class="mb-2">
    <select
      id="form-category"
      name="category"
      class="select select-bordered select-sm w-full"
      required>
      <% categories.forEach(function(cat) { %>
        <option value="<%= cat.name %>">
          <%= cat.icon %> - <%= cat.name %>
        </option>
      <% }); %>
    </select>
  </div>


    <script>
  console.log("🚚 ADD POINT FORM - GROUP:", <%- JSON.stringify(group) %>);
  console.log("🚚 ADD POINT FORM - SERVICES:", <%- JSON.stringify(group?.services || {}) %>);
</script>
  
<!-- Type de service spécifique au mobile-service -->


<% if (
  group &&
  group.groupType === "mobile-service" &&
  (group.services?.collecter || group.services?.livrer)
) { %>

  <div class="mb-3">
    <label class="label">
      <span class="label-text font-semibold">
        Type de service
      </span>
    </label>

    <div class="flex gap-4">
          <% if (group.services.collecter) { %>
    <label class="flex items-center gap-2 cursor-pointer"> 
        <input type="radio" name="serviceType" value="collecter" class="radio radio-primary" 
        <% if (group.services.collecter) { %>checked<% } %> /> 
        <span>📥 Collecter</span> 
    </label>
        <% } %>

      <% if (group.services.livrer) { %>
      <label class="flex items-center gap-2 cursor-pointer">
         <input type="radio" 
         name="serviceType"
          value="livrer" class="radio radio-primary"
           <% if (!group.services.collecter) { %>checked<% } %> />
            <span>📤 Livrer</span>
      </label>
       <% } %>

    </div>
  </div>

<% } %>


<!-- Campi specifici del gruppo -->

<% if (group && group.groupType === "observation") { %>

  <%- include("form/observationFields") %>

<% } %>

  <div class="mb-1">
 <textarea
  id="form-description"
  name="description"
  rows="2"
  class="textarea textarea-bordered textarea-sm w-full"
  placeholder="Description"></textarea>
  </div>

  <div class="mb-2">
    <input
      type="file"
      name="image"
      class="file-input file-input-bordered file-input-sm w-full"
    />
  </div>

<div class="sticky bottom-0 bg-white pt-2">
  <button  id="submit-point-btn" type="submit" class="btn btn-primary w-full">
    Ajouter
  </button>
</div>
</form>