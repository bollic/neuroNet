<!-- views/partials/form/observationFields.ejs -->

<div id="observation-fields">

    <% if (observationForm && observationForm.fields && observationForm.fields.length > 0) { %>

        <div class="divider">
            Observation
        </div>

        <% observationForm.fields.forEach(function(field) { %>

            <% if (field.type === "text") { %>

                <div class="mb-2">
                    <label class="text-xs">
                        <%= field.label %>
                        <% if (field.required) { %>
                            <span class="text-error">*</span>
                        <% } %>
                    </label>

                    <input
                        type="text"
                        name="observation[<%= field.name %>]"
                        class="input input-bordered input-sm w-full"
                        <% if (field.required) { %>required<% } %>
                    />
                </div>

            <% } %>


            <% if (field.type === "number") { %>

                <div class="mb-2">
                    <label class="text-xs">
                        <%= field.label %>
                        <% if (field.required) { %>
                            <span class="text-error">*</span>
                        <% } %>
                    </label>

                    <input
                        type="number"
                        step="any"
                        name="observation[<%= field.name %>]"
                        class="input input-bordered input-sm w-full"
                        <% if (field.required) { %>required<% } %>
                    />
                </div>

            <% } %>


            <% if (field.type === "boolean") { %>

                <label class="flex gap-2 items-center mb-2">

                    <input
                        type="checkbox"
                        name="observation[<%= field.name %>]"
                        value="true"
                        class="checkbox checkbox-sm"
                    />

                    <span>
                        <%= field.label %>
                    </span>

                </label>

            <% } %>


            <% if (field.type === "select") { %>

                <div class="mb-2">

                    <label class="text-xs">
                        <%= field.label %>
                        <% if (field.required) { %>
                            <span class="text-error">*</span>
                        <% } %>
                    </label>

                    <select
                        name="observation[<%= field.name %>]"
                        class="select select-bordered select-sm w-full"
                        <% if (field.required) { %>required<% } %>
                    >

                        <option value="">
                            Choisir
                        </option>

                        <% field.options.forEach(function(option) { %>

                            <option value="<%= option %>">
                                <%= option %>
                            </option>

                        <% }); %>

                    </select>

                </div>

            <% } %>

        <% }); %>

    <% } %>

</div>